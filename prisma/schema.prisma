generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
}

model ContentGroup {
  id       Int       @id @default(autoincrement())
  name     String
  position Int       @default(0)
  topics   Topic[]
  contents Content[]
}

model Topic {
  id         Int          @id @default(autoincrement())
  group_id   Int
  title      String
  icon       String?
  position   Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  
  group      ContentGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  contents   Content[]
}

model Content {
  id         Int          @id @default(autoincrement())
  group_id   Int
  topic_id   Int?         // Optional: if null, it belongs directly to the group
  title      String
  slug       String?      @unique
  icon       String?      // Optional icon (e.g. fa-solid fa-code)
  body_en    String
  body_bn    String
  position   Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  
  group      ContentGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  topic      Topic?       @relation(fields: [topic_id], references: [id], onDelete: Cascade)
}
